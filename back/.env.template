# =============================================
# Firebase Admin SDK — Service Account
# Obtén estas credenciales en:
# Firebase Console → Project Settings → Service Accounts → Generate new private key
# =============================================

FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxx@your_project_id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nTU_PRIVATE_KEY_AQUI\n-----END PRIVATE KEY-----\n"
FIREBASE_DATABASE_URL=https://your_project_id.firebaseio.com

# =============================================
# Firebase Web SDK — Client config
# Obtén estas credenciales en:
# Firebase Console → Project Settings → General → Your apps → Web app
# =============================================

FIREBASE_API_KEY=your_api_key_here
FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
FIREBASE_APP_ID=your_app_id
FIREBASE_MEASUREMENT_ID=your_measurement_id

# =============================================
# Cloudflare R2 — Object Storage
# Obtén estas credenciales en:
# Cloudflare Dashboard → R2 → Manage R2 API tokens
# Account ID: Cloudflare Dashboard → lado derecho → Account ID
# =============================================

# ID de cuenta Cloudflare (ej: a1b2c3d4e5f6...)
CF_R2_ACCOUNT_ID=your_cloudflare_account_id

# Credenciales del API token R2 (permisos: Object Read & Write)
CF_R2_ACCESS_KEY_ID=your_r2_access_key_id
CF_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key

# Nombre del bucket R2 creado en Cloudflare
CF_R2_BUCKET_NAME=toolapp

# (Opcional) Dominio público personalizado si configuraste un Custom Domain en R2
# Ej: https://cdn.surmotor.cl  (sin slash final)
# Si se omite, se usa la URL pública por defecto del bucket R2
CF_R2_PUBLIC_DOMAIN=

# =============================================
# Server
# =============================================
PORT=3000
